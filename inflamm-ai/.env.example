#############################################
# Wearable Integration OAuth Credentials
#############################################

#############################################
# Fitbit (OAuth 2)
# Register: https://dev.fitbit.com/apps
#############################################
FITBIT_CLIENT_ID=your_fitbit_client_id
FITBIT_CLIENT_SECRET=your_fitbit_client_secret
FITBIT_REDIRECT_URI=http://localhost:3000/api/auth/fitbit/callback


#############################################
# Google Fit (OAuth 2)
# Register: https://console.cloud.google.com/apis/credentials
# Requires: Fitness API enabled
#############################################
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/googlefit/callback


#############################################
# Garmin Connect (OAuth 2)
# Register: https://developer.garmin.com/partner-program/
# Garmin requires special approval to access production data
#############################################
GARMIN_CLIENT_ID=your_garmin_client_id
GARMIN_CLIENT_SECRET=your_garmin_client_secret
GARMIN_REDIRECT_URI=http://localhost:3000/api/auth/garmin/callback


#############################################
# Oura Ring (OAuth 2)
# Register: https://cloud.ouraring.com/oauth/applications
#############################################
OURA_CLIENT_ID=your_oura_client_id
OURA_CLIENT_SECRET=your_oura_client_secret
OURA_REDIRECT_URI=http://localhost:3000/api/auth/oura/callback


#############################################
# Firebase Configuration (Google Sign-In)
# Get these from: https://console.firebase.google.com/
# 1. Create a new project or select existing
# 2. Go to Authentication > Sign-in method
# 3. Enable Google sign-in
# 4. Go to Project Settings > General > Your apps
# 5. Add a web app and copy the configuration
#############################################
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

