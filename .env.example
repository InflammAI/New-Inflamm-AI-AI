# API Keys
# Get your API key from https://newsapi.org (Free tier available)
# Note: No NEXT_PUBLIC_ prefix - this is server-side only for security
NEWS_API_KEY=your_api_key_here

# Solana RPC Endpoint (optional)
# Default: Public Solana mainnet (slow, rate-limited)
# Recommended: Get a free API key from https://www.helius.dev or https://www.alchemy.com
# Example: NEXT_PUBLIC_SOLANA_RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY_HERE
NEXT_PUBLIC_SOLANA_RPC_ENDPOINT=
