# ============================================
# Vital Sync Backend - Environment Variables
# ============================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=vitalsync_user
DB_PASSWORD=your_secure_password_here
DB_NAME=vitalsync_db

# JWT Configuration
JWT_SECRET=your_very_secure_jwt_secret_key_min_32_chars
JWT_REFRESH_SECRET=your_very_secure_refresh_secret_key_min_32_chars

# Encryption (for OAuth tokens)
ENCRYPTION_KEY=your_very_secure_encryption_key_32_chars

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@vitalsync.com

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# External Services (Device Integrations)
FITBIT_CLIENT_ID=your_fitbit_client_id
FITBIT_CLIENT_SECRET=your_fitbit_secret
OURA_CLIENT_ID=your_oura_client_id
OURA_CLIENT_SECRET=your_oura_secret
GARMIN_CLIENT_ID=your_garmin_client_id
GARMIN_CLIENT_SECRET=your_garmin_secret

# Logging & Monitoring
LOG_LEVEL=info
